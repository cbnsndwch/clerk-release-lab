{
    "name": "clerk-release-lab",
    "version": "0.1.0",
    "private": true,
    "description": "A community demo of Clerk transactional email, device authorization, and MCP with Client ID Metadata Documents.",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "build": "node scripts/demo/build.ts",
        "start": "pnpm build && node scripts/demo/email.ts",
        "test": "pnpm build && node --test scripts/demo/*.test.ts scripts/*.test.ts",
        "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm privacy",
        "format": "oxfmt .",
        "privacy": "node scripts/privacy-audit.ts",
        "lint": "oxlint --type-aware scripts",
        "lint:fix": "oxlint --type-aware --fix scripts",
        "format:check": "oxfmt --check .",
        "gate": "pnpm check",
        "typecheck": "tsc --noEmit",
        "doctor": "node scripts/doctor.ts"
    },
    "dependencies": {
        "@clerk/backend": "3.23.2",
        "esbuild": "0.28.2",
        "lucide-react": "1.47.0",
        "qrcode": "1.5.4",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-email": "6.11.1"
    },
    "devDependencies": {
        "@types/node": "24.10.0",
        "@types/qrcode": "1.5.6",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "oxfmt": "0.70.0",
        "oxlint": "1.85.0",
        "oxlint-tsgolint": "7.0.2001",
        "typescript": "5.9.3"
    },
    "engines": {
        "node": ">=24.0.0",
        "pnpm": ">=12.5.1"
    },
    "packageManager": "pnpm@12.5.1"
}
