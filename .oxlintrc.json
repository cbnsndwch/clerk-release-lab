{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "categories": {
        "correctness": "warn"
    },
    "options": {
        "maxWarnings": 0,
        "typeAware": true
    },
    "env": {
        "node": true,
        "es2024": true
    },
    "plugins": ["import", "react", "typescript"],
    "rules": {
        "curly": ["error", "all"],
        "import/newline-after-import": [
            "error",
            {
                "count": 1,
                "exactCount": true,
                "considerComments": true
            }
        ],
        "no-unused-expressions": "error",
        "no-var": "error",
        "prefer-const": "error",
        "react/jsx-key": "error",
        "react/no-children-prop": "error"
    },
    "ignorePatterns": [
        "**/dist/**",
        "**/node_modules/**",
        ".local/**",
        "coverage/**"
    ],
    "overrides": [
        {
            "files": ["**/*.tsx"],
            "env": {
                "browser": true,
                "node": false
            }
        }
    ]
}
