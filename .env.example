# Blank credentials = local email composer preview. No email can be sent.
# Optional: your own production Clerk instance with transactional email enabled.
CLERK_EMAIL_SECRET_KEY=
# Optional: your own DEVELOPMENT Clerk instance for OAuth labs.
CLERK_OAUTH_SECRET_KEY=
# Explicit opt-in: creates/reuses the demo OAuth client and enables CIMD advertising
# in that development instance. See README before enabling.
CLERK_CONFIGURE_OAUTH=false
# Optional: requires cloudflared on PATH. Exposes only the restricted port below.
DEMO_TUNNEL=false
# Or point your own public HTTPS reverse proxy at DEMO_ASSET_PORT.
DEMO_PUBLIC_BASE_URL=
# Optional alternative HTTPS directory for GIFs used in sent email.
DEMO_ASSET_BASE_URL=
DEMO_PORT=4318
DEMO_ASSET_PORT=4319
